# Copy to repo root as `.env` — never commit the filled-in version.
#   cp infra/env.example .env

# Required — `docker compose up` refuses to start the clickhouse container
# if this is unset or blank (compose interpolation error, fails fast).
CLICKHOUSE_PASSWORD=

# Optional (defaults shown; override only if you need a different port/user/db)
CLICKHOUSE_USER=admin
CLICKHOUSE_DB=market_predict
CLICKHOUSE_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
REDIS_PORT=6379
